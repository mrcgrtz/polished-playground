  "devDependencies": {
    "cross-env": "^10.1.0",
    "postcss-styled-syntax": "^0.7.3",
    "preact-cli": "^3.5.1",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "xo": "^5.0.1"
  }
}
